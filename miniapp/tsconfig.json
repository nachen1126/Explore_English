{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["@tarojs/taro", "node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["../packages/shared/src/*"], "@shared": ["../packages/shared/src/index.ts"] }
  },
  "include": ["src", "config", "test", "../packages/shared/src"]
}
